# Copy to /etc/systemd/system/ and replace <user> (see docs/setup.md).
[Unit]
Description=Saku weekly: full-history refetch and diff, checks, recompute, layer E (pnpm verify)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=<user>
WorkingDirectory=/home/<user>/code/saku
Environment=PATH=/home/<user>/.local/share/saku/node/bin:/usr/bin:/bin
Environment=COREPACK_ENABLE_DOWNLOAD_PROMPT=0
Nice=10
CPUQuota=150%
ExecStart=/home/<user>/.local/share/saku/node/bin/pnpm weekly
TimeoutStartSec=4h
