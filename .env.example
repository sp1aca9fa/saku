# Copy to .env on the server (never commit .env).

# Signs sessions and encrypts authenticator secrets and alert targets. 32+ random characters,
# e.g. `openssl rand -base64 48`. Keep it in a password manager: a restored database needs it.
AUTH_SECRET=

# Provider keys (market data is shared by the install's accounts). A source whose key is missing
# is skipped and the run is reported incomplete.
TIINGO_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
MASSIVE_API_KEY=
FRED_API_KEY=

# RFC 3161 timestamp authorities for the forward records' daily anchor, comma-separated, tried in
# order (none: not timestamped, logged). Tokens are verified against SAKU_TSA_CAFILE (default: the
# system's CA bundle); an authority with its own CA needs that CA in the file.
# SAKU_TSA_URLS=
# SAKU_TSA_CAFILE=

# healthchecks.io check URL: pinged after each fully successful daily run.
HEALTHCHECK_URL=

# Optional: New York time after which a day's data counts as final (default 20:00).
# Earlier than 20:00 leaves the target day's FX rate from a London-day source to the next run.
# SAKU_DAILY_AFTER=20:00
# Optional: the ticker the finalization probe fetches (default: the first symbol).
# SAKU_PROBE_TICKER=SPY

# Optional: the database file (default ~/.local/share/saku/saku.db).
# DATABASE_URL=file:/path/to/saku.db
# Optional: other folders for a second copy on the same machine.
# SAKU_DATA_DIR=
# SAKU_STATE_DIR=
# SAKU_BACKUP_DIR=

# Telegram bot for alerts (one per install, from @BotFather). Each user adds their chat id with
# `pnpm channel add telegram --user <name>`. Discord needs nothing here (webhooks).
# TELEGRAM_BOT_TOKEN=
