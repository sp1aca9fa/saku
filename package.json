{
  "name": "saku",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck && node scripts/typecheck-plugins.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:all": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm docs:check",
    "db:generate": "pnpm --filter @saku/db generate",
    "db:migrate": "pnpm --filter @saku/db migrate",
    "user": "pnpm --silent --filter @saku/db user",
    "settings": "pnpm --silent --filter @saku/db settings",
    "symbols": "pnpm --silent --filter @saku/db symbols",
    "bootstrap": "pnpm --silent --filter @saku/plugin-sdk jobs bootstrap",
    "daily": "pnpm --silent --filter @saku/plugin-sdk jobs daily",
    "checks": "pnpm --silent --filter @saku/plugin-sdk jobs checks",
    "docs:build": "node scripts/docs-build.mjs",
    "docs:check": "node scripts/docs-build.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@saku/core": "workspace:*",
    "@saku/db": "workspace:*",
    "@saku/plugin-sdk": "workspace:*",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
